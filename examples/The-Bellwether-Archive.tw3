  "title": "The Bellwether Archive",
  "medium": "game",
  "unit": "beat",
  "description": "A missing archivist. A city that edits its own history. Three lives caught between the truth and the stories that keep them safe.",
  "updatedAt": "2026-11-07T10:51:33.024Z",
  "events": [
    {
      "id": "e-start",
      "title": "A letter after midnight",
      "description": "An unsigned letter summons Mara to the shuttered municipal archive. Someone has erased an entire district from the maps.",
      "role": "beginning",
      "behavior": "static",
      "begin": 0,
      "end": 2,
      "x": 120,
      "y": 390
    },
    {
      "id": "e-choice",
      "title": "The price of the truth",
      "description": "Ivo offers the original ledger. The player must decide whether to expose it or protect the people named inside.",
      "role": "event",
      "behavior": "static",
      "begin": 5,
      "end": 7,
      "x": 465,
      "y": 390
    },
    {
      "id": "e-reveal",
      "title": "Open the archive",
      "description": "The ledger is broadcast across the city. Ivo becomes a witness, and the erased district returns to public memory.",
      "role": "ending",
      "behavior": "dynamic",
      "begin": 12,
      "end": 15,
      "x": 840,
      "y": 290
    },
    {
      "id": "e-protect",
      "title": "Burn the ledger",
      "description": "The names remain a secret. The keeper helps Mara disappear, but the official history survives.",
